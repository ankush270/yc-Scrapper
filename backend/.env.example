# Neon PostgreSQL Database Connection URL
# Leave blank to fall back to a local SQLite database (local.db) automatically
DATABASE_URL=postgres://your_neon_user:your_neon_password@your_neon_host.neon.tech/neondb?sslmode=require

# Google Gemini API Key for AI Analysis & Idea Generator
GEMINI_API_KEY=AIzaSyYourGeminiAPIKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI API Key & Model Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-2b-v0.5

# OpenAI API Key & Model Configuration
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key & Model Configuration
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq Cloud API Key & Model Configuration
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Grok (xAI) API Key & Model Configuration
XAI_API_KEY=xai-...
GROK_MODEL=grok-2-1212

